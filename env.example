# Copy this file to .env and fill in the values before running docker compose up.
# docker compose automatically loads .env, so every variable here reaches the
# containers without extra flags.

# ---------------------------------------------------------------------------
# REQUIRED
# ---------------------------------------------------------------------------

# The public hostname reachable through your Cloudflare Tunnel.
# Must match the `hostname:` entry in cloudflared/config.yml and the
# [server.http].url value in stalwart/config.toml.
#
# Stalwart v0.16+ reads STALWART_PUBLIC_URL / STALWART_HOSTNAME on every
# boot to build every URL it advertises: apiUrl, downloadUrl, uploadUrl,
# eventSourceUrl in the JMAP /session response, plus OAuth issuer and
# autoconfig/autodiscover entries.  Without it the session response contains
# https://<container-id>/jmap/... which is unreachable from the internet, so
# JMAP clients authenticate successfully then hang on every subsequent request.
STALWART_PUBLIC_URL=https://mail.example.com
STALWART_HOSTNAME=mail.example.com

# ---------------------------------------------------------------------------
# OPTIONAL — uncomment to enable
# ---------------------------------------------------------------------------

# Pin a permanent admin credential instead of letting Stalwart generate a
# random one at first boot (printed to stdout once and then gone forever).
# Format: username:password
# STALWART_RECOVERY_ADMIN=admin:changeme

# Set to 1 to force recovery mode (read-only, open admin endpoint).
# Useful if you lock yourself out of the web UI.
# STALWART_RECOVERY_MODE=0
